# VOLTRA local run logs and Python caches
_logs/
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# PERSONAL HEALTH DATA — never commit.
#
# The Health Auto Export payload is a minute-by-minute record of one person's
# heart rate, HRV, sleep, and walking gait. It is the most sensitive thing this
# project touches. The server reads and writes it under _data/; the root path
# is the old location, kept ignored so an older copy can never be committed
# either. Anything that looks like an export is ignored by pattern too.
# ---------------------------------------------------------------------------
_data/
health_payload.json
*health_payload*.json
*HealthAutoExport*.json
/export*.json

# ---------------------------------------------------------------------------
# SECRETS — never commit.
# ---------------------------------------------------------------------------
.env
.env.*
*.env
secrets.*
*.secret
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
key.properties
service-account*.json
google-services.json
GoogleService-Info.plist

# iOS — generated by `pod install` on the build machine, never committed
/ios/Pods/
/ios/Podfile.lock
/ios/.symlinks/
/ios/Flutter/ephemeral/
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
